  <script>\
    // 1. \uc0\u35531 \u23559 \u19979 \u26041 \u32178 \u22336 \u26367 \u25563 \u28858 \u27493 \u39519 \u19968 \u20013 \u21462 \u24471 \u30340  Apps Script \u32178 \u38913 \u25033 \u29992 \u31243 \u24335  URL\
    const GAS_API_URL = "{\field{\*\fldinst{HYPERLINK "https://script.google.com/macros/s/AKfycbzPiGUQ8k34936NLX-dviH8m9RjLNTKOoxO4L3Tjk-OSJpg-rbUFvgdmE7J6YtOW1-wJg/exec"}}{\fldrslt 
\f1\fs26 https://script.google.com/macros/s/AKfycbzPiGUQ8k34936NLX-dviH8m9RjLNTKOoxO4L3Tjk-OSJpg-rbUFvgdmE7J6YtOW1-wJg/exec}}";\
\
    async function fetchMessages() \{\
      const board = document.getElementById('board');\
      try \{\
        const response = await fetch(GAS_API_URL);\
        const data = await response.json();\
\
        // \uc0\u36991 \u20813 \u37325 \u35079 \u37325 \u26032 \u28210 \u26579 \u23566 \u33268 \u21205 \u30059 \u38275 \u29197 \u65288 \u21487 \u20381 \u29376 \u27841 \u35519 \u25972 \u65289 \
        board.innerHTML = '';\
\
        if (!data || data.length === 0) \{\
          board.innerHTML = '<div class="loading">\uc0\u27193 \u27934 \u35041 \u36996 \u27794 \u26377 \u30041 \u35328 \u65292 \u25104 \u28858 \u31532 \u19968 \u20491 \u30041 \u19979 \u24515 \u32882 \u30340 \u20154 \u21543 \u65281 </div>';\
          return;\
        \}\
\
        // \uc0\u26368 \u26032 \u30041 \u35328 \u39023 \u31034 \u22312 \u26368 \u19978 \u26041 \
        data.reverse().forEach((item, index) => \{\
          const note = document.createElement('div');\
          \
          // \uc0\u38568 \u27231 \u20998 \u37197 \u20415 \u21033 \u36028 \u38991 \u33394 \
          const styleIndex = index % 4;\
          const styleClass = styleIndex > 0 ? `alt-$\{styleIndex\}` : '';\
          \
          // \uc0\u38568 \u27231 \u35282 \u24230  (-3.5\u24230  \u21040  +3.5\u24230 )\u65292 \u35069 \u36896 \u33258 \u28982 \u24494 \u20670 \u26012 \u25928 \u26524 \
          const randomDeg = (Math.random() * 7 - 3.5).toFixed(1);\
          \
          note.className = `note $\{styleClass\}`;\
          note.style.transform = `rotate($\{randomDeg\}deg)`;\
\
          note.innerHTML = `\
            <div class="note-to">To: $\{escapeHtml(item.receiver || '\uc0\u28961 ')\}</div>\
            <div class="note-body">$\{escapeHtml(item.message || '')\}</div>\
            <div class="note-from">\'97\'97 $\{escapeHtml(item.sender || '\uc0\u21311 \u21517 ')\}</div>\
          `;\
\
          board.appendChild(note);\
        \});\
\
      \} catch (error) \{\
        console.error("\uc0\u25235 \u21462 \u30041 \u35328 \u22833 \u25943 \u65306 ", error);\
      \}\
    \}\
\
    // \uc0\u38450  XSS \u25915 \u25802 \u36681 \u25563 \u20989 \u25976 \
    function escapeHtml(str) \{\
      return str.replace(/&/g, "&amp;")\
                .replace(/</g, "&lt;")\
                .replace(/>/g, "&gt;")\
                .replace(/"/g, "&quot;")\
                .replace(/'/g, "&#039;");\
    \}\
\
    // \uc0\u21021 \u27425 \u36617 \u20837 \
    fetchMessages();\
\
    // \uc0\u27599  5 \u31186 \u33258 \u21205 \u23526 \u26178 \u26356 \u26032  (5000ms)\
    setInterval(fetchMessages, 5000);\
\
    // \uc0\u30070 \u20351 \u29992 \u32773 \u22635 \u23436 \u34920 \u21934 \u20999 \u25563 \u22238 \u27492 \u35222 \u31383 \u26178 \u65292 \u31435 \u21051 \u21047 \u26032 \
    window.addEventListener('focus', fetchMessages);\
  </script>\
